// Cloudflare Worker that serves the static build. Deployed by Workers Builds on push to main.
{
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html for unknown paths instead of an empty 404.
    "not_found_handling": "404-page"
  }
}
