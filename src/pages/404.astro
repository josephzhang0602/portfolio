---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found · Joseph Zhang">
  <section class="nf">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>This page <span class="serif grad">doesn't exist</span>.</h1>
      <p>The link may be old or mistyped.</p>
      <a href="/" class="btn btn-primary">Back to the homepage</a>
    </div>
  </section>
</Layout>

<style>
  .nf { min-height: 70vh; display: flex; align-items: center; text-align: center; }
  .nf .eyebrow::before { display: none; }
  h1 { font-size: clamp(36px, 6vw, 64px); margin-top: 16px; }
  p { color: var(--muted); font-size: 18px; margin: 16px 0 32px; }
</style>
