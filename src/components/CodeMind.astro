---
import Icon from './Icon.astro';
import Showcase from './codemind/Showcase.astro';
import Metrics from './codemind/Metrics.astro';
import { codemind as cm } from '../data/codemind.js';
---
<section id="codemind" class="cm">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">02 · Flagship product</span>
      <h2>{cm.name}: <span class="serif grad">a whole product</span>, end to end.</h2>
      <p>{cm.summary}</p>
    </div>

    <Showcase />
    <Metrics />

    <div class="cm-ctas reveal">
      <a href="/codemind" class="btn btn-primary">Read the case study <Icon name="arrow" size={16} /></a>
      <a href={cm.url} target="_blank" rel="noopener" class="btn btn-ghost">
        <span class="live-dot"></span> Visit live site
      </a>
    </div>
  </div>
</section>

<style>
  .cm { background: linear-gradient(to bottom, transparent, var(--bg-2) 30%, var(--bg-2) 85%, transparent); }
  .cm .section-head { max-width: 720px; }
  .cm-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 48px; }
  .live-dot { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; }
  @media (max-width: 640px) {
    .cm-ctas .btn { width: 100%; justify-content: center; }
  }
</style>
