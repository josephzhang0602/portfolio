---
import Icon from './Icon.astro';
import { site } from '../data/site.js';
import { apps, featuredApps, totalRatings } from '../data/apps.js';

const fmt = (n) => n.toLocaleString('en-US');
const stars = (r) => Math.round(r || 0);
const since = Math.min(...apps.map((a) => Number(a.released?.slice(0, 4)) || 9999));
---
<section id="apps" class="apps">
  <div class="container">
    <div class="apps-head">
      <div class="section-head reveal">
        <span class="eyebrow">03 · Independent apps</span>
        <h2>30+ apps on the App Store, <span class="serif grad">4M+ installs</span>.</h2>
        <p>
          Since {since} I have designed, built, launched and monetized my own iOS and macOS apps, from language learning to
          on-device speech and generative AI tools, with {fmt(totalRatings)}+ ratings so far.
        </p>
      </div>
      <a href={site.appStore} target="_blank" rel="noopener" class="btn btn-ghost reveal store">
        <Icon name="apple" size={16} /> View on the App Store
      </a>
    </div>

    <div class="featured">
      {featuredApps.map((a, i) => (
        <a href={a.url} target="_blank" rel="noopener" class="feat card spot reveal" data-delay={String(i % 3)}>
          {a.screenshot && (
            <div class="feat-shot" aria-hidden="true">
              <img src={a.screenshot} alt="" width="460" height="818" loading="lazy" />
            </div>
          )}
          <div class="feat-body">
          <div class="feat-top">
            <img src={a.icon} alt="" width="72" height="72" loading="lazy" class="feat-icon" />
            <div class="feat-meta">
              <h3>{a.name}</h3>
              {a.gloss && <span class="gloss">{a.gloss}</span>}
              <span class="genre">{a.genre}{a.ai && <span class="ai-tag">AI</span>}</span>
            </div>
          </div>
          <p class="feat-blurb">{a.blurb}</p>
          <div class="feat-foot">
            <span class="rating">
              <span class="stars" aria-label={`${a.rating} out of 5`}>
                {[1, 2, 3, 4, 5].map((n) => <span class={n <= stars(a.rating) ? 'on' : ''}><Icon name="star" size={13} /></span>)}
              </span>
              <b>{a.rating?.toFixed(1)}</b>
              <span class="count">{fmt(a.ratings)} ratings</span>
            </span>
            <span class="go"><Icon name="arrow" size={16} /></span>
          </div>
          </div>
        </a>
      ))}
    </div>

    <a href={site.appStore} target="_blank" rel="noopener" class="btn btn-ghost store-bottom">
      <Icon name="apple" size={16} /> See all my apps on the App Store
    </a>
  </div>
</section>

<style>
  .apps-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .store { margin-bottom: 56px; flex-shrink: 0; }

  .featured { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .feat { display: flex; flex-direction: column; transition: transform 0.25s, border-color 0.25s; }
  .feat-body { padding: 22px 24px 24px; display: flex; flex-direction: column; gap: 16px; flex: 1; }
  .feat-shot {
    position: relative; height: 210px; margin: 10px 10px 0; border-radius: 12px; overflow: hidden;
    display: flex; justify-content: center; align-items: flex-start; padding-top: 22px;
    background: radial-gradient(90% 80% at 50% 100%, var(--accent-soft), transparent 70%), var(--surface-2);
    border: 1px solid var(--border);
  }
  .feat-shot img {
    width: 54%; height: auto; border-radius: 14px; box-shadow: var(--shadow-lg);
    transition: transform 0.4s cubic-bezier(.2,.7,.2,1);
  }
  .feat:hover .feat-shot img { transform: translateY(-14px) scale(1.02); }
  .feat:hover { transform: translateY(-3px); border-color: var(--border-strong); }
  .feat-top { display: flex; gap: 16px; align-items: center; }
  .feat-icon { width: 72px; height: 72px; border-radius: 22.5%; border: 1px solid var(--border); box-shadow: var(--shadow); flex-shrink: 0; }
  .feat-meta { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .feat h3 { font-size: 17px; letter-spacing: -0.01em; line-height: 1.25; }
  .gloss { font-size: 13px; color: var(--muted); line-height: 1.35; }
  .genre { font-size: 12px; color: var(--faint); display: flex; align-items: center; gap: 6px; }
  .ai-tag {
    font-family: var(--mono); font-size: 10px; font-weight: 500; padding: 1px 6px; border-radius: 5px;
    background: var(--accent-soft); color: var(--accent);
  }
  .feat-blurb { color: var(--muted); font-size: 15px; flex: 1; }
  .feat-foot { display: flex; align-items: center; justify-content: space-between; padding-top: 16px; border-top: 1px solid var(--border); }
  .rating { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .stars { display: flex; gap: 1px; color: var(--border-strong); }
  .stars .on { color: var(--star); }
  .count { color: var(--faint); font-size: 13px; }
  .go {
    width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center;
    border: 1px solid var(--border); color: var(--muted); transition: all 0.25s;
  }
  .feat:hover .go { background: var(--text); color: var(--bg); border-color: var(--text); }

  @media (max-width: 900px) {
    .apps-head { flex-direction: column; align-items: flex-start; gap: 0; }
    .store { margin: -24px 0 40px; }
    .featured { grid-template-columns: 1fr 1fr; }
  }
  .store-bottom { display: none; }

  @media (max-width: 640px) {
    .featured { grid-template-columns: 1fr; gap: 12px; }
    .feat:nth-child(n + 5) { display: none; }
    .feat-body { padding: 18px; gap: 14px; }
    .feat-shot { height: 170px; }
    .feat-shot img { width: 46%; }
    .feat-icon { width: 60px; height: 60px; }
    .feat-blurb { font-size: 14px; }
    .feat-foot { padding-top: 12px; }
    .store { display: none; }
    .store-bottom { display: flex; width: 100%; justify-content: center; margin-top: 16px; }
  }
</style>
